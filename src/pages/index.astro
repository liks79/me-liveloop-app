---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        🌼 Always, Mingalaba! 🌼
      </h1>

      <p>
        밍글라바! 언제나 당신께 좋은 일과 축복이 함께하길 바랍니다! 
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://en.wikipedia.org/wiki/Mingalaba"
          >
          "Mingalaba"
        </LinkButton>
        라는 미얀마 단어를 
        
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-accent"
          href="https://github.com/satnaing/astro-paper"
        >
          AstroPaper
        </LinkButton> 를 통해서 알게 되었습니다. 새롭게 블로그를 시작하면서 인사말로 잘 어울리는 것 같습니다. 
        빠르게 변화하는 기술의 흐름 속에서, 특히 AI가 모든 것을 바꾸고 있는 듯한 이 시대에, 때로는 조급함과 불안함을 동시에 느끼기도 합니다. 새로운 모델과 프레임워크, 매일같이 등장하는 도구들 사이에서 뒤처지지 않으려 애쓰다 보면 문득 “나는 어디쯤 와 있는 걸까? 잘못된 길을 가고 있지는 않은걸까?”라는 질문을 스스로에게 던지게 됩니다.
        <p class="mt-2">
          그럼에도 불구하고, 거대한 파도 같은 AI FOMO 속에서 하루 하루를 느끼며 견뎌가고 있는 한 사람의 IT 엔지니어로서, 저는 아주 소소한 기록들을 남겨보려 합니다. 거창한 통찰이나 정답을 제시하기보다는, 실제로 부딪히고 고민하고 시행착오를 겪으며 배운 것들—아키텍처에 대한 생각, 클라우드 운영 경험, DevOps와 자동화의 작은 팁들, 그리고 기술을 대하는 태도에 대한 단상들을 차분히 쌓아가고자 합니다.
        </p>
        <p class="mt-2">
          아마도 이 공간은 ‘최신’을 가장 빠르게 전하는 곳은 아닐것 같습니다. 대신, 변화의 한복판에서 어떻게 생각하고, 어떻게 배우고, 어떻게 버티고 있는지를 기록하는 자리일 것 같습니다. 그렇게 남겨진 작은 발자취들이 언젠가 누군가에게는 위로가 되고, 또 다른 누군가에게는 시작의 힌트가 되기를 바랍니다.
        </p>
        이 공간에 남겨진 기록들이 누군가에게는 작은 도움이 되거나, 영감을 주기를 바랍니다.
        </p>
        <p class="mt-2">🌈✨Say! <strong>밍글라바! 🍀</strong></p>

      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
